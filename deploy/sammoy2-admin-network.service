[Unit]
Description=SAMMOY2 administrator NetworkManager adapter
After=NetworkManager.service
Requires=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/sammoy/sammoy2/deploy/admin-network-agent.py
RuntimeDirectory=sammoy2-admin
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=sammoy2-admin
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/sammoy2-admin /var/lib/sammoy2-admin

[Install]
WantedBy=multi-user.target
